// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Authentication (Auth.js / NextAuth adapter schema)
// ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // bcrypt hash; null for OAuth users
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  workoutSessions WorkoutSession[]
  preference     UserPreference?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ──────────────────────────────────────────────────────────────
// Exercise Catalog
// ──────────────────────────────────────────────────────────────

model Exercise {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  description          String   @db.Text
  muscleGroups         String[] // e.g. ["Quads", "Glutes", "Core"]
  difficulty           Difficulty @default(BEGINNER)
  defaultTargetReps    Int      @default(12)
  defaultSets          Int      @default(3)
  restDurationSeconds  Int      @default(60)
  imageUrl             String?
  // Serialized ExerciseConfig JSON for analyzer thresholds
  analysisConfig       Json
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workoutSessions WorkoutSession[]

  @@index([slug])
  @@map("exercises")
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ──────────────────────────────────────────────────────────────
// Workout Sessions
// ──────────────────────────────────────────────────────────────

model WorkoutSession {
  id          String        @id @default(cuid())
  userId      String
  exerciseId  String
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  duration    Int?          // seconds
  totalReps   Int           @default(0)
  formScore   Float?        // 0–100
  status      SessionStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])
  sets     WorkoutSet[]

  @@index([userId])
  @@index([exerciseId])
  @@index([startedAt])
  @@index([userId, startedAt])
  @@map("workout_sessions")
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model WorkoutSet {
  id           String    @id @default(cuid())
  sessionId    String
  setNumber    Int
  targetReps   Int
  completedReps Int      @default(0)
  duration     Int?      // seconds
  formScore    Float?    // 0–100
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reps    RepRecord[]

  @@unique([sessionId, setNumber])  // idempotency: can't have duplicate set numbers
  @@index([sessionId])
  @@map("workout_sets")
}

model RepRecord {
  id              String   @id @default(cuid())
  setId           String
  repNumber       Int
  timestamp       DateTime @default(now())
  confidence      Float    // 0–1
  movementQuality Float    // 0–1

  set WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@map("rep_records")
}

// ──────────────────────────────────────────────────────────────
// User Preferences
// ──────────────────────────────────────────────────────────────

model UserPreference {
  id                   String  @id @default(cuid())
  userId               String  @unique
  defaultTargetReps    Int     @default(12)
  defaultSets          Int     @default(3)
  defaultRestSeconds   Int     @default(60)
  preferredExerciseId  String?
  theme                Theme   @default(DARK)
  preferredUnits       Units   @default(METRIC)
  fitnessGoal          String?
  targetWeeklyWorkouts Int     @default(3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum Theme {
  DARK
  LIGHT
  SYSTEM
}

enum Units {
  METRIC
  IMPERIAL
}
